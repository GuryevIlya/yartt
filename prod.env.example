# yartt for work, in Docker: copy to prod.env, fill in, then
#   docker run -d --name yartt -p 3000:3000 --env-file prod.env yartt/public:<version>
# Never put DEMO_DATA here: a demo runs without sign-in (demo.env.example).

# PostgreSQL 16+ (external). The user must own the database: the first start
# creates the extensions citext, pgcrypto, btree_gist, pg_trgm, fuzzystrmatch.
DATABASE_URL=postgres://yartt:<password>@<host>:5432/yartt

# The address employees open, over HTTPS (used in links in emails).
PUBLIC_URL=https://tasks.example.com

# Email — required: sign-in links, invites and notifications go by it.
# smtp://user:password@host:587 or smtps://user:password@host:465
SMTP_URL=smtps://<user>:<password>@smtp.example.com:465
MAIL_FROM=yartt <noreply@example.com>

# Optional: the company's mail domains, comma-separated. No other address is
# accepted; someone who already has one may only change it.
EMAIL_DOMAINS=

# Files: at most FILE_MAX_MB each; a person's files at most FILE_QUOTA_MB
# together (deleting the content of old ones frees it).
FILE_MAX_MB=50
FILE_QUOTA_MB=1024

# Optional: attached files in an S3-compatible object storage instead of PostgreSQL
# (AWS S3, Yandex Object Storage, MinIO). Set later, the worker moves the files there.
S3_BUCKET=
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The first employee, created only while the database has no employees.
FIRST_EMPLOYEE_EMAIL=ceo@example.com
FIRST_EMPLOYEE_NAME=Full Name
FIRST_EMPLOYEE_LOCALE=en
FIRST_EMPLOYEE_TIME_ZONE=Europe/London

# Optional: every message also POSTed as JSON to a webhook (Telegram, Slack, …),
# signed with X-Yartt-Signature: sha256=HMAC-SHA256("<X-Yartt-Timestamp>.<body>", secret).
WEBHOOK_URL=
WEBHOOK_SECRET=

# Bots' own webhooks reach only addresses outside the company's network. Hosts
# inside it they may reach, comma-separated (e.g. ci.corp.local). Empty — none.
BOT_WEBHOOK_INTERNAL_HOSTS=

# all | api | worker — to run the API and the worker in separate containers.
ROLE=all
